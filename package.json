{
  "name": "pith",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Pith — the essential web, for agents. OSS engine for clean, LLM-ready web content (scrape, crawl, extract, search, MCP).",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "npm run build -w @use-pith/core && npm run build -w @use-pith/adapters-pg && npm run build -w @use-pith/adapters-minio && npm run build -w @use-pith/adapters-bullmq",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:smoke": "vitest run --project smoke",
    "test:integration:real": "vitest run --project integration-real",
    "test:integration:nock": "vitest run --project integration-nock",
    "test:accuracy": "vitest run --project accuracy",
    "prepublishOnly": "npm run build && npm run test:smoke && npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/jsdom": "^21.1.7",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^26.1.2",
    "@types/turndown": "^5.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "fastify": "^4.28.1",
    "nock": "^14.0.16",
    "playwright": "^1.61.1",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0",
    "vitest": "^2.0.5",
    "zod-to-json-schema": "^3.25.2"
  }
}
