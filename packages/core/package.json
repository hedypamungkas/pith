{
  "name": "@use-pith/core",
  "version": "0.1.2",
  "type": "module",
  "description": "Pith — the essential web, for agents. Embeddable engine: URL→clean markdown, crawl, structured extract, search, MCP (SDK + HTTP + MCP faces).",
  "license": "Apache-2.0",
  "author": "The Pith Authors",
  "homepage": "https://github.com/hedypamungkas/pith#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedypamungkas/pith.git",
    "directory": "packages/core"
  },
  "bugs": { "url": "https://github.com/hedypamungkas/pith/issues" },
  "keywords": [
    "web",
    "scraping",
    "crawler",
    "markdown",
    "readability",
    "extraction",
    "llm",
    "agents",
    "mcp",
    "model-context-protocol",
    "firecrawl"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "ajv": "^8.20.0",
    "jsdom": "^30.0.1",
    "minimatch": "^10.2.5",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.0",
    "zod": "^3.23.8"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./handlers": {
      "types": "./dist/handlers/index.d.ts",
      "import": "./dist/handlers/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "engines": { "node": ">=18.18.0" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^4.28.1 || ^5.0.0",
    "playwright": "^1.61.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": { "optional": true },
    "fastify": { "optional": true },
    "playwright": { "optional": true },
    "zod-to-json-schema": { "optional": true }
  }
}
